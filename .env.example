# Required
DATABASE_URL="postgresql://ladder:password@127.0.0.1:5432/ladder"

# Standard base64 of at least 64 random bytes (`openssl rand -base64 64 | tr -d '\n'`).
# Keys the anonymous-voter fingerprint HMAC. Changing it resets every anonymous voter.
COOKIE_KEY="your-base64-cookie-key"

# Optional
# BIND_ADDR="127.0.0.1:3000"
# Origin the site is served from. OAuth redirect URIs are built from it.
# PUBLIC_BASE_URL="http://localhost:3000"
# Reverse proxies whose X-Forwarded-For is trusted (comma-separated IPs or CIDRs).
# TRUSTED_PROXIES="127.0.0.1"

# OAuth apps. Set both values of a provider to enable it.
# Redirect URI: ${PUBLIC_BASE_URL}/auth/{discord|reddit}/callback
# DISCORD_CLIENT_ID="your-discord-oauth-client-id"
# DISCORD_CLIENT_SECRET="your-discord-oauth-client-secret"
# REDDIT_CLIENT_ID="your-reddit-oauth-client-id"
# REDDIT_CLIENT_SECRET="your-reddit-oauth-client-secret"
# Required with Reddit: "<platform>:<app id>:<version> (by /u/<username>)"
# REDDIT_USER_AGENT="web:trackerrankings:v0.1.0 (by /u/your-reddit-username)"

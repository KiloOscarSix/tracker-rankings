# Required
DATABASE_URL="postgresql://ladder:password@127.0.0.1:5432/ladder"

# Base64 of at least 64 random bytes (`openssl rand -base64 64 | tr -d '\n'`).
# Signs session cookies and keys the anonymous-voter fingerprint HMAC.
# COOKIE_KEY="your-base64-cookie-key"

# Optional
# BIND_ADDR="127.0.0.1:3000"
# PUBLIC_BASE_URL="http://127.0.0.1:3000"

# OAuth apps (milestone 5). Redirect URI: ${PUBLIC_BASE_URL}/auth/{provider}/callback
# DISCORD_CLIENT_ID="your-discord-oauth-client-id"
# DISCORD_CLIENT_SECRET="your-discord-oauth-client-secret"
# REDDIT_CLIENT_ID="your-reddit-oauth-client-id"
# REDDIT_CLIENT_SECRET="your-reddit-oauth-client-secret"

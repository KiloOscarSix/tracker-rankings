{
  "db_name": "PostgreSQL",
  "query": "SELECT t.slug, t.name, m.status::text AS \"status!\",\n                  r.axis::text AS \"axis?\", r.score AS \"score?\"\n           FROM memberships m\n           JOIN trackers t ON t.id = m.tracker_id\n           LEFT JOIN ratings r\n               ON r.voter_id = m.voter_id AND r.tracker_id = m.tracker_id\n           WHERE m.voter_id = $1\n           ORDER BY t.name, t.slug",
